root ::= select_stmt ";"?

select_stmt ::= select_kw ws select_list ws from_kw ws table_refs where_clause? group_by? order_by? limit_clause?

ws ::= (" " | "\n" | "\t")+

select_kw ::= "SELECT" | "select" | "Select"
from_kw ::= "FROM" | "from" | "From"
where_kw ::= "WHERE" | "where" | "Where"
group_kw ::= "GROUP" | "group" | "Group"
order_kw ::= "ORDER" | "order" | "Order"
by_kw ::= "BY" | "by" | "By"
limit_kw ::= "LIMIT" | "limit" | "Limit"
as_kw ::= "AS" | "as" | "As"
and_kw ::= "AND" | "and" | "And"
or_kw ::= "OR" | "or" | "Or"
not_kw ::= "NOT" | "not" | "Not"
join_kw ::= "JOIN" | "join" | "Join"
inner_kw ::= "INNER" | "inner" | "Inner"
left_kw ::= "LEFT" | "left" | "Left"
right_kw ::= "RIGHT" | "right" | "Right"
on_kw ::= "ON" | "on" | "On"
asc_kw ::= "ASC" | "asc" | "Asc"
desc_kw ::= "DESC" | "desc" | "Desc"
like_kw ::= "LIKE" | "like" | "Like"
in_kw ::= "IN" | "in" | "In"
null_kw ::= "NULL" | "null" | "Null"

agg_name ::= "COUNT" | "count" | "Count" | "SUM" | "sum" | "Sum" | "AVG" | "avg" | "Avg" | "MIN" | "min" | "Min" | "MAX" | "max" | "Max"

select_list ::= select_item ("," ws? select_item)*
select_item ::= "*" | agg | qualified_name | name
agg ::= agg_name "(" ws? ("*" | qualified_name | name) ws? ")"

table_refs ::= table_item (ws join_clause)*
table_item ::= name (ws (as_kw ws)? name)?
join_clause ::= (join_kw | inner_kw ws join_kw | left_kw ws join_kw | right_kw ws join_kw) ws table_item (ws on_kw ws expr)?

where_clause ::= ws where_kw ws expr
group_by ::= ws group_kw ws by_kw ws name ("," ws? name)*
order_by ::= ws order_kw ws by_kw ws order_item ("," ws? order_item)*
order_item ::= (qualified_name | name | number) (ws (asc_kw | desc_kw))?
limit_clause ::= ws limit_kw ws number

expr ::= term (ws (and_kw | or_kw) ws term)*
term ::= (not_kw ws)? (comparison | "(" ws? expr ws? ")")
comparison ::= value ws? comp_op ws? value
comp_op ::= "=" | "!=" | "<>" | ">" | ">=" | "<" | "<=" | like_kw | in_kw
value ::= qualified_name | name | number | string | null_kw | "(" ws? value_list ws? ")"
value_list ::= value ("," ws? value)*

qualified_name ::= name "." name
name ::= [A-Za-z_] [A-Za-z0-9_]*
number ::= ("+" | "-")? [0-9]+ ("." [0-9]+)?
string ::= "'" [^']* "'"
